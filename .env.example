APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

TRADING_MODE=research

LIVE_TRADING_ENABLED=false
PAPER_TRADING_ENABLED=true
SHADOW_TRADING_ENABLED=true

AI_CAN_EXECUTE_LIVE=false
FX_AUTO_LEARN_ON_STARTUP=true
FX_AUTO_START_BOTS=false
FX_TRAINING_THREADS=2
FX_MIN_RETRAIN_SECONDS=86400
FX_FAILED_TRAINING_RETRY_SECONDS=21600
FX_GLOBAL_TRAINING_LIMIT=64
FX_TRAINING_MAX_LOAD=6.0
FX_TRAINING_MAX_CPU_PERCENT=85
FX_BOT_MAX_CPU_PERCENT=85
FX_LEARNING_BETWEEN_JOBS_SECONDS=30
FX_LEARNING_IDLE_SECONDS=1800
AI_CAN_CHANGE_RISK_LIMITS=false
AI_CAN_ACCESS_BROKER_SECRETS=false

MANUAL_LIVE_APPROVAL_REQUIRED=true

OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

KIMI_ENABLED=false
KIMI_API_KEY=
KIMI_MODEL=kimi-k3

HF_TOKEN=

ALPACA_ENABLED=false
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
