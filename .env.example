APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

TRADING_MODE=research

LIVE_TRADING_ENABLED=false
PAPER_TRADING_ENABLED=true
SHADOW_TRADING_ENABLED=true

AI_CAN_EXECUTE_LIVE=false
FX_AUTO_LEARN_ON_STARTUP=true
FX_AUTO_START_BOTS=false
FX_TRAINING_THREADS=2
FX_MIN_RETRAIN_SECONDS=86400
FX_FAILED_TRAINING_RETRY_SECONDS=21600
FX_GLOBAL_TRAINING_LIMIT=64
FX_TRAINING_MAX_LOAD=6.0
FX_TRAINING_MAX_CPU_PERCENT=85
FX_BOT_MAX_CPU_PERCENT=85
FX_LEARNING_BETWEEN_JOBS_SECONDS=30
FX_LEARNING_IDLE_SECONDS=1800
AI_CAN_CHANGE_RISK_LIMITS=false
AI_CAN_ACCESS_BROKER_SECRETS=false

MANUAL_LIVE_APPROVAL_REQUIRED=true

OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2.6
OPENROUTER_COUNCIL_MODELS=

# Optional OpenAI-compatible multi-provider fusion service.
FREELLMAPI_ENABLED=false
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=fusion

# Goose is a read-only committee reviewer; it is not a trading model.
GOOSE_CHAT_ENABLED=false
GOOSE_PATH=/Users/macmac/.local/bin/goose
GOOSE_PROVIDER=openrouter
GOOSE_MODEL=z-ai/glm-5.2:free

# Headroom may compress oversized committee context. Failure is fail-open.
HEADROOM_ENABLED=false
HEADROOM_BASE_URL=http://127.0.0.1:8787

KIMI_ENABLED=false
KIMI_API_KEY=
KIMI_MODEL=kimi-k3

HF_TOKEN=

ALPACA_ENABLED=false
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

BINANCE_TESTNET_ENABLED=false
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Personal notification channels. Backend only; never expose these in UI.
DISCORD_WEBHOOK_URL=

# Local security and operations
FX_AUTH_ACCOUNT=jacobo
FX_AUTH_ISSUER=FX
FX_SECURE_COOKIE=false
FX_SENTINEL_INTERVAL_SECONDS=60
FX_AGENT_TEAM_INTERVAL_SECONDS=300
FX_AGENT_MAX_TOTAL_EXPOSURE_PERCENT=50

DATABASE_URL=sqlite+aiosqlite:///./data/fx.db
DUCKDB_PATH=./data/duckdb/fx.duckdb
REDIS_URL=redis://127.0.0.1:6379/0
